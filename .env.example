# Local development settings. Copy this file to .env and change the password if needed.
POSTGRES_USER=datapulse
POSTGRES_PASSWORD=datapulse_dev_password
POSTGRES_DB=datapulse

# Open-Meteo location (defaults to Delhi)
OPEN_METEO_LATITUDE=28.6139
OPEN_METEO_LONGITUDE=77.2090

# Host ports
POSTGRES_PUBLISHED_PORT=5432
API_PORT=8000
FRONTEND_PORT=3000

# The frontend uses the same-origin API proxy by default. This is a public build-time URL.
VITE_API_BASE_URL=/api
